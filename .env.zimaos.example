# AssetTrack TI - ZimaOS
#
# Copie para .env.zimaos e ajuste antes da primeira inicializacao:
# cp .env.zimaos.example .env.zimaos

SECRET_KEY=troque_esta_chave_por_um_valor_grande_e_seguro
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
PROJECT_NAME=AssetTrack TI
TZ=America/Sao_Paulo

POSTGRES_USER=assettrack
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=assettrack

# URLs internas do Docker Compose do ZimaOS. Nao precisam apontar para localhost.
DATABASE_URL=postgres://assettrack:troque_esta_senha@db:5432/assettrack?sslmode=disable
REDIS_URL=redis://redis:6379/0

# Ajuste para o IP ou dominio do seu ZimaOS.
# Exemplo: http://192.168.1.50:8080/api/v1
VITE_API_URL=http://IP_DO_ZIMAOS:8080/api/v1

# Portas publicadas no ZimaOS.
WEB_PORT=8000
API_PORT=8080
