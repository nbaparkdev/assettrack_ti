# Cadastre estas variaveis na interface do EasyPanel (nao envie este arquivo com senhas ao Git).
# Gere valores fortes, por exemplo:
#   openssl rand -base64 36

POSTGRES_USER=assettrack
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
POSTGRES_DB=assettrack

SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_LONGA_ALEATORIA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
PROJECT_NAME=AssetTrack TI
TZ=America/Sao_Paulo

# Mantenha relativo para que web, API e uploads usem o mesmo dominio HTTPS.
VITE_API_URL=/api/v1

# Opcionais; altere apenas quando publicar uma nova versao do cliente.
VITE_APP_VERSION_CODE=2
VITE_APP_VERSION_NAME=1.2.0
VITE_APP_BUILD_TIMESTAMP=
